{
  "name": "ndexplorer",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --coverage --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "secrets": "secretlint \"**/*\"",
    "kill": "lsof -ti:4321 | xargs kill -9 2>/dev/null; echo 'Port 4321 killed...'",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/node": "11.1.14",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "secretlint": "14.1.0",
    "tailwindcss": "4.3.5",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
