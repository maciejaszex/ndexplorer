{
  "name": "ndexplorer",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --coverage --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "secrets": "secretlint \"**/*\"",
    "kill": "lsof -ti:4321 | xargs kill -9 2>/dev/null; echo 'Port 4321 killed...'",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-pattern": "13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "happy-dom": "20.14.5",
    "husky": "9.1.7",
    "secretlint": "13.0.5",
    "tailwindcss": "4.3.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
